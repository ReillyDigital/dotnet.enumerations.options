<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Company>Reilly Digital</Company>
		<Description>A lightweight, zero-allocation result object library for .NET with discriminated union types for void, value, none, and error outcomes.</Description>
		<EnableSourceLink>true</EnableSourceLink>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>12.0</LangVersion>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<Nullable>enable</Nullable>
		<PackageId>ReillyDigital.Enumerations.Options</PackageId>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://gitlab.com/reilly-digital/dotnet/enumerations.options</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageTags>csharp, c#, dotnet, result, option, zero-allocation, exceptionless, result-type, maybe, error, void, error-handling, discriminated-union, functional</PackageTags>
		<PackageVersion>2.0.0-alpha.13</PackageVersion>
		<ProjectGuid>AA0DA09D-1C29-47B8-912B-D323505872C3</ProjectGuid>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://gitlab.com/reilly-digital/dotnet/enumerations.options.git</RepositoryUrl>
		<RootNamespace>ReillyDigital.Enumerations.Options</RootNamespace>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<TargetFramework>net8.0</TargetFramework>
		<Title>ReillyDigital.Enumerations.Options - A lightweight, zero-allocation result object library for .NET.</Title>
		<Version>2.0.0-alpha.13</Version>
	</PropertyGroup>
	<ItemGroup Label="Global Usings">
		<Using Include="ReillyDigital.Enumerations.Options" />
		<Using Include="ReillyDigital.Enumerations.Options.Boxed" />
		<Using Include="ReillyDigital.Enumerations.Options.Boxed._Internal" />
		<Using Include="ReillyDigital.Enumerations.OptionsFunctions" Static="true" />
	</ItemGroup>
	<ItemGroup Label="File References">
		<None Include="../../README.md">
			<Pack>True</Pack>
			<PackagePath>/</PackagePath>
		</None>
	</ItemGroup>
</Project>
